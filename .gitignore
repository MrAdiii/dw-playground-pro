# Maven build output
target/

# Mule runtime binaries — must be downloaded separately per MuleSoft licensing
# Place the runtime root directly in mule-runtime/ (so mule-runtime/bin/mule exists)
mule-runtime/*
!mule-runtime/.gitkeep

# EE license file — CE users leave license/ empty
license/*.lic
!license/.gitkeep

# Deployed application jars (generated by build script)
apps/*.jar
!apps/.gitkeep

# IDE files
.idea/
*.iml
.classpath
.project
.settings/
*.launch

# OS files
.DS_Store
Thumbs.db

# Anypoint Studio metadata
studio_metadata/
.mule/
